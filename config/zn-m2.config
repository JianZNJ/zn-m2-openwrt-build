CONFIG_PACKAGE_libyaml=y
CONFIG_PACKAGE_lua-neturl=y
CONFIG_PACKAGE_nss-eip-firmware=y

# ===== 代理 =====
CONFIG_PACKAGE_luci-app-openclash=y

# ===== 去广告（adblock-fast 在 21.02 源中不存在，改用 adblock）=====
CONFIG_PACKAGE_adblock=y
CONFIG_PACKAGE_luci-app-adblock=y
CONFIG_PACKAGE_luci-i18n-adblock-zh-cn=y

# ===== 爆破防护（banip + 从上游 openwrt/luci 补的界面）=====
CONFIG_PACKAGE_banip=y
CONFIG_PACKAGE_luci-app-banip=y


# ===== VPN（与 x86 一致：L2TP/IPSec + WireGuard）=====
CONFIG_PACKAGE_strongswan-default=y
